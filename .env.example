# ---------------------------------------------------------------------------
# SocialHub API — copy to .env and fill in. Never commit a real .env.
# ---------------------------------------------------------------------------

NODE_ENV=development
APP_NAME=socialhub-api
PORT=4000
HOST=0.0.0.0

# Postgres (development: the docker compose service; production: PgBouncer VIP)
DATABASE_URL=postgres://socialhub_app:socialhub_dev_password@localhost:5433/socialhub
DATABASE_POOL_MAX=20
DATABASE_SSL=false

# Cache / rate limiting (required unless CACHE_DRIVER=memory in development)
REDIS_URL=redis://localhost:6379
CACHE_DRIVER=redis

# Tokens: generate with `openssl rand -base64 48`
JWT_ACCESS_SECRET=replace-me-with-at-least-32-characters-of-entropy
JWT_REFRESH_SECRET=replace-me-with-a-different-32-plus-character-secret
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000
JWT_ISSUER=socialhub
JWT_AUDIENCE=socialhub-api

# Argon2id (OWASP minimum is 19456 KiB; we use 47104)
ARGON2_MEMORY_KIB=47104
ARGON2_TIME_COST=3
ARGON2_PARALLELISM=1

MAX_FAILED_LOGINS=5
LOCKOUT_SECONDS=900
OTP_TTL_SECONDS=600
OTP_MAX_ATTEMPTS=5

TRUST_PROXY=true
CORS_ORIGINS=http://localhost:3000

MAIL_FROM=SocialHub <no-reply@socialhub.local>
MAIL_TRANSPORT=log

LOG_LEVEL=info
