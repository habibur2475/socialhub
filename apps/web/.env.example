# Web app — copy to .env.local. Never commit a real .env.

# Where the Next.js server proxies /api/* in development.
API_INTERNAL_URL=http://localhost:4000

# Only set this if the browser must call the API directly (a different origin).
# Leaving it unset keeps requests same-origin, which the __Host- cookies require.
# NEXT_PUBLIC_API_BASE_URL=
