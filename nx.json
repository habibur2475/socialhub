{
  "$schema": "https://json.schemastore.org/nx-schema",
  "targetDefaults": {
    "build": { "cache": true, "dependsOn": ["^build"], "outputs": ["{projectRoot}/dist"] },
    "typecheck": { "cache": true, "dependsOn": ["^build"] },
    "lint": { "cache": true },
    "test": { "cache": true }
  },
  "defaultBase": "main",
  "namedInputs": {
    "default": ["{projectRoot}/**/*", "sharedGlobals"],
    "sharedGlobals": ["{workspaceRoot}/tsconfig.base.json", "{workspaceRoot}/package.json"],
    "production": ["default", "!{projectRoot}/**/*.spec.ts", "!{projectRoot}/**/*.test.ts"]
  }
}
